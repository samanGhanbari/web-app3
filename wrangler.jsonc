{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app3",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9d8c8fe4-3d45-4a0b-b3bc-6ddd1f95f19c","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "ec101795a5384a0dad0ae84aa6a6d5a7" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
